# Supabase integration configuration. These values alone do not migrate the app.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never use a NEXT_PUBLIC_ prefix for the secret key.
SUPABASE_SECRET_KEY=
# Existing waitlist adapter currently uses this legacy server-only key.
SUPABASE_SERVICE_ROLE_KEY=
# Local portal host; production host/routing must be configured before launch.
PORTAL_ROOT_DOMAIN=localhost

# Runtime backend: keep file until db:migrate and db:check both succeed.
JOINZY_DATA_BACKEND=file
# Migration only; never expose this PostgreSQL password to browsers.
SUPABASE_DB_URL=
